{
  "name": "plotcat",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "description": "SVG plot recreation exercises for Quarto",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:unit": "node --test --test-isolation=none",
    "test:transform": "node tests/transform-check.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "test": "pnpm test:unit && pnpm test:transform && pnpm test:browser",
    "check": "pnpm test && pnpm build && pnpm test:e2e",
    "prebuild": "node -e \"fs.rmSync('website/_extensions/plotcat',{recursive:true,force:true});fs.cpSync('_extensions/plotcat','website/_extensions/plotcat',{recursive:true})\"",
    "build": "pnpm prebuild && quarto render website",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
